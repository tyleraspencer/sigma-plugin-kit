# Optional client_credentials pair, read by scripts/load-env.sh. The preferred
# auth path (scripts/api/browser-login.sh) needs no .env at all -- see
# docs/auth.md. Ignored so one never gets committed.
.env
.env.*.local

# Personal Claude Code settings (per-user)
.claude/settings.local.json

# Python bytecode cache (generated by any python3/py_compile invocation)
__pycache__/
*.pyc

# Read-only mirror of upstream skills (refresh via scripts/refresh-vendor.sh)
vendor/

# Harvest/scratch output. scripts/api/harvest-workbook.sh writes specs pulled
# from a live org here; they are customer data, not repo content.
workbooks/

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Note: no token/keychain state is ever written inside the repo tree.
# _env.sh's cache lives at $SIGMA_TOKEN_CACHE (default: a per-user path
# under $XDG_RUNTIME_DIR/$TMPDIR, outside this repo); browser-login.sh's
# refresh token lives in the OS keychain, or a 0600 file under
# $SIGMA_STATE_DIR when no keychain exists -- _state.sh hard-refuses a
# $SIGMA_STATE_DIR that resolves inside this repo.

# Scaffolded plugins are working files, not kit content. The public host repo
# (tyleraspencer/sigma-plugins) is the single source of truth for deployed
# plugin HTML -- keeping a second copy here drifts silently, since nothing
# compares them. Only the template new-plugin.sh copies from is tracked.
plugins/*/
!plugins/_react-template/

# Build artefacts inside a React-archetype plugin. The template itself is
# tracked; nobody's node_modules or dist is.
plugins/*/node_modules/
plugins/*/dist/
plugins/*/package-lock.json
plugins/*/yarn.lock
